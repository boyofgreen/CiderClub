# ─── Database ─────────────────────────────────────────────────────────────────
# Azure PostgreSQL Flexible Server — sslmode=require is mandatory on Azure
DATABASE_URL="postgresql://ciderclub_admin:YOUR_PASSWORD@YOUR_SERVER.postgres.database.azure.com:5432/ciderclub?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Set to your production domain (no trailing slash)
NEXTAUTH_URL="https://your-app.azurewebsites.net"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── OAuth Providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated — these emails get ADMIN role automatically on first login
ADMIN_EMAILS="owner@hillcountryciderhouse.com"

# ─── Square ───────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
NEXT_PUBLIC_SQUARE_APP_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Hill Country Cider Club <hello@hillcountryciderhouse.com>"

# ─── App ──────────────────────────────────────────────────────────────────────
# Must match deployed URL exactly — used in magic links and email CTAs
NEXT_PUBLIC_APP_URL="https://your-app.azurewebsites.net"
NEXT_PUBLIC_CLUB_NAME="Hill Country Cider Club"

# ─── Platform (multi-tenant) ──────────────────────────────────────────────────
# Root domain for tenant subdomains: <org-slug>.<PLATFORM_ROOT_DOMAIN>.
# Requests to the root itself use the default org (tenant zero). Any other
# host is looked up as a tenant custom domain.
PLATFORM_ROOT_DOMAIN="localhost"

# ─── Square platform app (OAuth) ──────────────────────────────────────────────
# From the Square Developer Console — the platform-level app that tenants
# authorize via OAuth. SQUARE_APP_ID falls back to NEXT_PUBLIC_SQUARE_APP_ID.
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""

# ─── Secrets encryption ───────────────────────────────────────────────────────
# 32 bytes, base64 — encrypts per-tenant Square tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""
