# ─── Database ─────────────────────────────────────────────────────────────────
# Azure PostgreSQL Flexible Server — sslmode=require is mandatory on Azure
DATABASE_URL="postgresql://ciderclub_admin:YOUR_PASSWORD@YOUR_SERVER.postgres.database.azure.com:5432/ciderclub?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Set to your production domain (no trailing slash)
NEXTAUTH_URL="https://your-app.azurewebsites.net"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ─── OAuth Providers ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ─── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated — these emails get ADMIN role automatically on first login
ADMIN_EMAILS="owner@hillcountryciderhouse.com"

# ─── Square ───────────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=""
SQUARE_LOCATION_ID=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
NEXT_PUBLIC_SQUARE_APP_ID=""
NEXT_PUBLIC_SQUARE_LOCATION_ID=""

# ─── Resend ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Hill Country Cider Club <hello@hillcountryciderhouse.com>"

# ─── App ──────────────────────────────────────────────────────────────────────
# Must match deployed URL exactly — used in magic links and email CTAs
NEXT_PUBLIC_APP_URL="https://your-app.azurewebsites.net"
NEXT_PUBLIC_CLUB_NAME="Hill Country Cider Club"
