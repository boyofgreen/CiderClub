generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/prisma-generated"
  // driverAdapters lets tests run against an in-process PGlite Postgres
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Adapter Tables ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Organizations (tenants) ──────────────────────────────────────────────────
// Each winery/cidery on the platform is an Organization. Every tenant-owned
// table carries organizationId; queries are scoped via the tenancy Prisma
// extension (src/lib/tenancy.ts). The original club is backfilled as the
// default organization by the organizations migration.

model Organization {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique // subdomain, e.g. "hill-country-cider-house"
  customDomain String? @unique // e.g. "club.hillcountryciderhouse.com"
  settings     Json    @default("{}") // theme, terminology, feature flags

  // Per-tenant integrations (populated by later phases; Square OAuth tokens
  // will be stored encrypted when Phase 3 lands)
  squareMerchantId String? @unique
  squareLocationId String?
  fromEmail        String?

  // Platform billing (Phase 5)
  planTier    String    @default("FOUNDER") // FOUNDER | TRIAL | STARTER | GROWTH | PRO
  trialEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              OrganizationUser[]
  members            Member[]
  memberTokens       MemberToken[]
  plans              Plan[]
  products           Product[]
  quarters           Quarter[]
  orders             Order[]
  pickupEvents       PickupEvent[]
  waitlistEntries    WaitlistEntry[]
  leads              Lead[]
  campaigns          Campaign[]
  emailLogs          EmailLog[]
  settings_          Setting[]
  emailTemplates     EmailTemplate[]
  pageViews          PageView[]
  clubEvents         ClubEvent[]
  analyticsSnapshots AnalyticsSnapshot[]
}

// ─── Users (OAuth accounts) ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("MEMBER") // ADMIN | MEMBER (legacy — org roles live on OrganizationUser)
  // Platform superadmin: full access to every organization (support/impersonation)
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  member         Member?            @relation("UserMember")
  orgMemberships OrganizationUser[]
}

// ─── Organization membership (operators, not club members) ───────────────────
// Which Users can run which Organization, and at what level. A user can
// belong to multiple orgs. Deliberately NOT in TENANT_MODELS — membership
// queries ("all my orgs") are cross-tenant by nature.

model OrganizationUser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("ADMIN") // OWNER | ADMIN | STAFF
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─── Members ─────────────────────────────────────────────────────────────────

model Member {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  // Linked to OAuth User (optional — members can exist without an OAuth account)
  userId    String? @unique
  user      User?   @relation("UserMember", fields: [userId], references: [id], onDelete: SetNull)

  // Contact info
  email     String
  firstName String
  lastName  String
  phone     String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?

  // Square
  squareCustomerId String? @unique
  squareCardId     String? // default card on file

  // Club membership
  planId              String
  plan                Plan         @relation(fields: [planId], references: [id])
  status              String       @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED | WAITLIST
  joinedAt            DateTime     @default(now())
  pausedAt            DateTime?
  pausedUntilQuarter  String?      // e.g. "2025-Q3" — auto-reactivate after this quarter
  cancelledAt         DateTime?
  cancellationReason  String?

  // Referrals
  referralCode       String  @unique @default(cuid())
  referredByMemberId String?
  referredBy         Member? @relation("Referrals", fields: [referredByMemberId], references: [id])
  referrals          Member[] @relation("Referrals")

  // Communication preferences
  eventAlertsOptIn Boolean @default(true) // receive emails about club events

  // Admin notes (CRM)
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders             Order[]
  emailLogs          EmailLog[]
  memberTokens       MemberToken[]
  waitlistEntries    WaitlistEntry[]
  pickupAttendances  PickupAttendance[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ─── Magic Link / Member Access Tokens ───────────────────────────────────────

model MemberToken {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  token      String   @unique
  type       String   @default("GENERAL") // GENERAL | ORDER_ACCESS | PROFILE_UPDATE
  resourceId String?  // e.g. orderId for ORDER_ACCESS tokens
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([organizationId])
}

// ─── Plans ────────────────────────────────────────────────────────────────────

model Plan {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name         String  // "6-Pack Quarterly"
  slug         String  // "6-pack-quarterly"
  description  String?
  packsPerOrder Int              // units included per quarterly order
  priceInCents  Int              // charged per quarter (in cents)
  discountPercent Int   @default(0) // tier discount applied at billing time (0-100)
  isActive      Boolean @default(true)
  maxCapacity   Int?             // null = unlimited
  sortOrder     Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members         Member[]
  waitlistEntries WaitlistEntry[]
  quarterDefaults QuarterPlanDefault[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  name        String
  slug        String
  description String?
  style       String?  // dry | semi-sweet | hopped | botanical | seasonal
  abv         Float?
  imageUrl     String?
  priceInCents Int      @default(2100) // per-bottle price, e.g. 2100 = $21.00
  isActive     Boolean  @default(true)
  squareItemId      String?  // Square catalog ITEM id (for reference)
  squareVariationId String?  // Square catalog ITEM_VARIATION id (used for inventory)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quarterProducts QuarterProduct[]
  quarterDefaults QuarterPlanDefault[]
  orderItems      OrderItem[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ─── Quarters ─────────────────────────────────────────────────────────────────

model Quarter {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  label  String // "2025-Q2"
  year   Int
  quarter Int               // 1-4
  name  String?             // optional friendly name e.g. "Summer 2025"

  // Key dates
  startsAt       DateTime   // when customization opens
  endsAt         DateTime   // customization deadline
  pickupStartsAt DateTime?
  pickupEndsAt   DateTime?  // auto-billing date if not picked up

  status String @default("UPCOMING")
  // UPCOMING | OPEN | LOCKED | BILLING | COMPLETED | ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products     QuarterProduct[]
  planDefaults QuarterPlanDefault[]
  orders       Order[]
  pickupEvents PickupEvent[]

  @@unique([organizationId, label])
  @@index([organizationId])
}

// QuarterProduct is the "available products" list for a quarter — one row per product.
// isDefault here means "default for everyone" (fallback when no per-plan default is set).
model QuarterProduct {
  id        String  @id @default(cuid())
  quarterId String
  quarter   Quarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  @@unique([quarterId, productId])
}

// Per-plan default selections for a quarter. When generating orders, these are
// preferred over QuarterProduct.isDefault for a member's specific plan.
model QuarterPlanDefault {
  id        String  @id @default(cuid())
  quarterId String
  quarter   Quarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([quarterId, planId, productId])
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  // Null quarterId = ad-hoc order composed by an admin, outside the quarterly
  // cycle. Postgres treats NULLs as distinct in unique constraints, so members
  // can hold many ad-hoc orders while staying limited to one per quarter.
  quarterId String?
  quarter  Quarter? @relation(fields: [quarterId], references: [id])

  // Order status lifecycle:
  // PENDING_CUSTOMIZATION → CUSTOMIZED → LOCKED → AWAITING_PICKUP
  // → PICKED_UP → BILLED  (or PAYMENT_FAILED or CANCELLED)
  status String @default("PENDING_CUSTOMIZATION")

  totalInCents Int @default(0)

  // Square payment
  squarePaymentId      String?
  squareReceiptUrl     String?
  squarePaymentLinkId  String?
  squarePaymentLinkUrl String?

  // Pickup
  pickupEventId String?
  pickupEvent   PickupEvent? @relation(fields: [pickupEventId], references: [id])
  pickedUpAt    DateTime?

  // Billing
  billedAt      DateTime?
  billingMethod String?   // CARD_ON_FILE | PAYMENT_LINK | IN_PERSON

  // Notes
  adminNotes  String?
  memberNotes String?

  // Customization tracking
  lastCustomizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@unique([memberId, quarterId])
  @@index([organizationId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  // unitPriceInCents: 0 = included in plan price; positive = add-on
  unitPriceInCents Int @default(0)
  createdAt DateTime @default(now())
}

// ─── Pickup Events ────────────────────────────────────────────────────────────

model PickupEvent {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  quarterId String
  quarter   Quarter @relation(fields: [quarterId], references: [id])
  title     String
  location  String?
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  isPublic  Boolean @default(true)
  maxSlots  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders      Order[]
  attendances PickupAttendance[]

  @@index([organizationId])
}

model PickupAttendance {
  id            String      @id @default(cuid())
  memberId      String
  member        Member      @relation(fields: [memberId], references: [id])
  pickupEventId String
  pickupEvent   PickupEvent @relation(fields: [pickupEventId], references: [id])
  rsvpAt        DateTime    @default(now())
  checkedInAt   DateTime?

  @@unique([memberId, pickupEventId])
}

// ─── Waitlist ─────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])
  email    String
  name     String?
  planId   String
  plan     Plan    @relation(fields: [planId], references: [id])
  position Int

  notifiedAt  DateTime?
  convertedAt DateTime? // when they became an active member

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ─── Leads ────────────────────────────────────────────────────────────────────
// People who started the signup flow (gave contact info) but didn't finish.
// Captured after step 1 of /register so the admin can follow up personally.

model Lead {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  email     String
  firstName String?
  lastName  String?
  phone     String?
  planId    String? // last plan they were looking at (no FK — plan may be deleted)

  // NEW | FOLLOWED_UP | CONVERTED | DISMISSED
  status       String    @default("NEW")
  followedUpAt DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId])
}

// ─── Email Campaigns ──────────────────────────────────────────────────────────

model Campaign {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  subject        String
  bodyHtml       String   // rendered HTML (from bodyMarkdown), used for send + preview
  bodyMarkdown   String?  // markdown source of truth authored by the admin
  bodyText       String?
  status         String   @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | CANCELLED
  sentAt         DateTime?
  scheduledAt    DateTime?
  recipientFilter String?  // JSON: { "status": ["ACTIVE"], "planIds": [] }
  sentCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ─── Email Logs ───────────────────────────────────────────────────────────────

model EmailLog {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id])
  toEmail  String
  subject  String
  // WELCOME | ORDER_READY | ORDER_REMINDER | CUSTOMIZATION_CLOSING |
  // RECEIPT | PAYMENT_FAILED | PICKUP_REMINDER | MAGIC_LINK |
  // CAMPAIGN | WAITLIST_NOTIFICATION
  type     String
  resendId String? // Resend message ID for delivery tracking
  status   String  @default("SENT") // SENT | FAILED | BOUNCED
  metadata String? // JSON blob for template data
  createdAt DateTime @default(now())

  @@index([organizationId])
}

// ─── App Settings ─────────────────────────────────────────────────────────────
// Simple key/value store for admin-configurable app settings (e.g. tax rate).

model Setting {
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  key       String
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([organizationId, key])
}

// ─── Editable Email Templates ─────────────────────────────────────────────────
// Admin-editable overrides for transactional emails. When a row is absent for a
// given key, the code-level default (see src/lib/emailTemplates.ts) is used.
// Body + subject support {{variable}} placeholders interpolated at send time.

model EmailTemplate {
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  key       String // matches a key in EMAIL_TEMPLATE_DEFS
  subject   String
  bodyHtml  String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([organizationId, key])
}

// ─── Page Views ──────────────────────────────────────────────────────────────
// Lightweight anonymous visit tracking for the acquisition funnel.
// No personal data stored — just path, referrer, and timestamp.

model PageView {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
  @@index([organizationId])
}

// ─── Club Events ─────────────────────────────────────────────────────────────
// Standalone events (release parties, tastings, farm visits, etc.)
// not tied to a pickup quarter.

model ClubEvent {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  title       String
  description String?
  eventType   String    @default("OTHER") // RELEASE_PARTY | TASTING | FARM_VISIT | WORKSHOP | OTHER
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  isPublic    Boolean   @default(true)
  imageUrl    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId])
}

// ─── Analytics Snapshots ──────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id             String       @id @default(cuid())
  organizationId String       @default("org_tenant_zero_hcch")
  organization   Organization @relation(fields: [organizationId], references: [id])
  snapshotDate     DateTime @default(now())
  totalMembers     Int
  activeMembers    Int
  pausedMembers    Int
  cancelledMembers Int
  waitlistCount    Int
  mrrInCents       Int // monthly recurring revenue approximation (qrr / 3)
  qrrInCents       Int // quarterly recurring revenue
  createdAt        DateTime @default(now())

  @@unique([organizationId, snapshotDate])
  @@index([organizationId])
}
